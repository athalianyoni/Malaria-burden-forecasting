  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "The plot revealed something that MAE alone hid: both models smooth the series. They tend to overpredict very low weeks and underpredict very high weeks. This motivated a quartile-by-quartile error analysis instead of relying only on one overall error number.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 14. Enhanced feature experiment using a separate 2022 validation year\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 110,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Second seasonal harmonic: allows a more flexible within-year pattern\n",
    "model_data[\"sin_week_2\"] = np.sin(\n",
    "    4 * np.pi * model_data[\"epidermiological week\"] / 52\n",
    ")\n",
    "\n",
    "model_data[\"cos_week_2\"] = np.cos(\n",
    "    4 * np.pi * model_data[\"epidermiological week\"] / 52\n",
    ")\n",
    "\n",
    "# Average case burden over the previous 2 weeks\n",
    "model_data[\"cases_roll_2\"] = (\n",
    "    model_data[\"cases\"]\n",
    "    .shift(1)\n",
    "    .rolling(2)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "# Average case burden over the previous 4 weeks\n",
    "model_data[\"cases_roll_4\"] = (\n",
    "    model_data[\"cases\"]\n",
    "    .shift(1)\n",
    "    .rolling(4)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "# Change from two weeks ago to last week\n",
    "model_data[\"cases_change\"] = (\n",
    "    model_data[\"cases_lag_1\"]\n",
    "    - model_data[\"cases_lag_2\"]\n",
    ")"
   ]
