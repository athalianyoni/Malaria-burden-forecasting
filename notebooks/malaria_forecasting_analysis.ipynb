    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "\n",
    "threshold_results = []\n",
    "\n",
    "for threshold in [0.30, 0.40, 0.50, 0.60, 0.70]:\n",
    "\n",
    "    predictions = (\n",
    "        val_classifier[\"high_burden_probability\"] >= threshold\n",
    "    ).astype(int)\n",
    "\n",
    "    cm = confusion_matrix(\n",
    "        y_val_clf,\n",
    "        predictions\n",
    "    )\n",
    "\n",
    "    tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "    threshold_results.append({\n",
    "        \"threshold\": threshold,\n",
    "        \"true_positives\": tp,\n",
    "        \"false_positives\": fp,\n",
    "        \"false_negatives\": fn,\n",
    "        \"precision\": precision_score(\n",
    "            y_val_clf,\n",
    "            predictions,\n",
    "            zero_division=0\n",
    "        ),\n",
    "        \"recall\": recall_score(\n",
    "            y_val_clf,\n",
    "            predictions,\n",
    "            zero_division=0\n",
    "        ),\n",
    "        \"f1\": f1_score(\n",
    "            y_val_clf,\n",
    "            predictions,\n",
    "            zero_division=0\n",
    "        )\n",
    "    })\n",
    "\n",
    "threshold_table = pd.DataFrame(threshold_results)\n",
    "\n",
    "threshold_table"
   ]
