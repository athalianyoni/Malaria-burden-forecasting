    "\n",
    "lag_features = [\n",
    "    \"cases_lag_1\",\n",
    "    \"cases_lag_2\",\n",
    "    \"cases_lag_3\",\n",
    "    \"cases_lag_4\"\n",
    "]\n",
    "\n",
    "train_scaled = train_m1.copy()\n",
    "test_scaled = test_m1.copy()\n",
    "\n",
    "train_scaled[lag_features] = scaler.fit_transform(\n",
    "    train_m1[lag_features]\n",
    ")\n",
    "\n",
    "test_scaled[lag_features] = scaler.transform(\n",
    "    test_m1[lag_features]\n",
    ")\n"
   ]
