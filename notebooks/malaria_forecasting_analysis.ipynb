  {
   "cell_type": "code",
   "execution_count": 25,
   "metadata": {},
   "outputs": [],
   "source": [
    "weekly_weather = (\n",
    "    weather.groupby([\"epi_year\", \"epi_week\"])\n",
    "    .agg(\n",
    "        avg_temperature=(\"temperature_2m (°C)\", \"mean\"),\n",
    "        total_rainfall=(\"rain (mm)\", \"sum\"),\n",
    "        n_hours=(\"peru_time\", \"count\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")"
