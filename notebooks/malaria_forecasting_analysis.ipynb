    "\n",
    "scaler_enhanced = StandardScaler()\n",
    "\n",
    "dev_scaled_values = scaler_enhanced.fit_transform(\n",
    "    dev_common[enhanced_numeric]\n",
    ")\n",
    "\n",
    "val_scaled_values = scaler_enhanced.transform(\n",
    "    val_common[enhanced_numeric]\n",
    ")\n",
    "\n",
    "dev_common[\"cases_lag_1_scaled\"] = dev_scaled_values[:, 0]\n",
    "dev_common[\"cases_change_scaled\"] = dev_scaled_values[:, 1]\n",
    "dev_common[\"cases_roll_4_scaled\"] = dev_scaled_values[:, 2]\n",
    "\n",
    "val_common[\"cases_lag_1_scaled\"] = val_scaled_values[:, 0]\n",
    "val_common[\"cases_change_scaled\"] = val_scaled_values[:, 1]\n",
    "val_common[\"cases_roll_4_scaled\"] = val_scaled_values[:, 2]\n"
   ]
