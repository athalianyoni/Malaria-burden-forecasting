   "source": [
    "## 17. Predictive uncertainty from the simplified Negative Binomial model\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 146,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Alpha: 0.112240803522589\n"
     ]
    }
   ],
   "source": [
    "# Negative Binomial overdispersion parameter\n",
    "alpha_simple = nb_model_simple.params[\"alpha\"]\n",
    "\n",
    "# Model's expected case count for each test week\n",
    "mu = test_simple[\"simple_prediction\"].values\n",
    "\n",
    "# Convert statsmodels NB2 parameters to scipy's Negative Binomial parameterisation\n",
    "size = 1 / alpha_simple\n",
    "prob = size / (size + mu)\n",
    "\n",
    "# Middle 80% predictive interval\n",
    "test_simple[\"pred_lower_80\"] = nbinom.ppf(\n",
    "    0.10,\n",
    "    size,\n",
    "    prob\n",
    ")\n",
    "\n",
    "test_simple[\"pred_upper_80\"] = nbinom.ppf(\n",
    "    0.90,\n",
    "    size,\n",
    "    prob\n",
    ")\n",
    "\n",
    "# Probability of 207 or more cases\n",
    "test_simple[\"prob_high_burden\"] = nbinom.sf(\n",
    "    206,\n",
    "    size,\n",
    "    prob\n",
    ")\n",
    "\n",
    "print(\"Alpha:\", alpha_simple)\n"
   ]
  },
