   "source": [
    "`dev_common` and `val_common` deliberately use the same eligible rows for the simple and enhanced models. This makes the comparison fair: a performance difference should come from the feature set rather than one model being trained on different observations.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 116,
   "metadata": {},
   "outputs": [],
   "source": [
    "enhanced_numeric = [\n",
