      "const                  5.0206      0.022    232.713      0.000       4.978       5.063\n",
      "cases_lag_1_scaled     0.2804      0.022     12.465      0.000       0.236       0.324\n",
      "sin_week              -0.0574      0.030     -1.906      0.057      -0.116       0.002\n",
      "cos_week              -0.0434      0.031     -1.399      0.162      -0.104       0.017\n",
      "alpha                  0.1122      0.010     10.788      0.000       0.092       0.133\n",
      "======================================================================================\n"
     ]
    }
   ],
   "source": [
    "X_train_simple = train_simple_common[features_simple_scaled]\n",
    "y_train_simple = train_simple_common[\"cases\"]\n",
    "\n",
    "X_train_simple = sm.add_constant(X_train_simple)\n",
    "\n",
    "nb_model_simple = NegativeBinomial(\n",
    "    y_train_simple,\n",
    "    X_train_simple\n",
    ").fit(\n",
    "    method=\"lbfgs\",\n",
    "    maxiter=1000\n",
    ")\n",
    "\n",
    "print(nb_model_simple.summary())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 97,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_test_simple = test_simple[features_simple_scaled]\n",
    "\n",
    "X_test_simple = sm.add_constant(\n",
    "    X_test_simple,\n",
    "    has_constant=\"add\"\n",
    ")\n",
    "\n",
    "test_simple[\"simple_prediction\"] = nb_model_simple.predict(\n",
    "    X_test_simple\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 98,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Simplified Model MAE: 29.300214781909055\n",
      "Simplified Model RMSE: 37.85832448351531\n"
     ]
    }
   ],
   "source": [
    "mae_simple = mean_absolute_error(\n",
    "    test_simple[\"cases\"],\n",
    "    test_simple[\"simple_prediction\"]\n",
    ")\n",
    "\n",
    "rmse_simple = np.sqrt(\n",
    "    mean_squared_error(\n",
    "        test_simple[\"cases\"],\n",
    "        test_simple[\"simple_prediction\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"Simplified Model MAE:\", mae_simple)\n",
    "print(\"Simplified Model RMSE:\", rmse_simple)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "The simplified model retains only the previous week's malaria count plus annual sine/cosine seasonality. It achieved the best MAE among the statistical models, showing that additional lag variables were adding complexity without improving future predictions.\n"
   ]
  },
  {
