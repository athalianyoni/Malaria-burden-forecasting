    "weather[\"week_start\"] = weather[\"week_end\"] - pd.Timedelta(days=6)\n",
    "\n",
    "weather[\"epi_year\"] = (\n",
    "    weather[\"week_start\"] + pd.Timedelta(days=3)\n",
    ").dt.year"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_epi_week(row):\n",
    "    year = row[\"epi_year\"]\n",
    "\n",
    "    jan4 = pd.Timestamp(year=year, month=1, day=4)\n",
    "\n",
    "    first_sunday = jan4 - pd.Timedelta(\n",
    "        days=(jan4.weekday() + 1) % 7\n",
    "    )\n",
    "\n",
    "    return ((row[\"week_start\"] - first_sunday).days // 7) + 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {},
   "outputs": [],
   "source": [
    "weather[\"epi_week\"] = weather.apply(get_epi_week, axis=1)"
   ]
